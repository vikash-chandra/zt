# ==========================================
# 1. COMMON SYSTEM CONFIGURATIONS
# ==========================================

# Zerodha API Connections
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_user_id_here
KITE_ACCESS_TOKEN=your_access_token_here
KITE_TOKEN_PREFIX=vj:zt-ut:
KITE_REDIRECT_URL=http://localhost:8080/
LIVE_TRADING=true
DEFAULT_ORDER_TYPE=LIMIT
SQUARE_OFF_ON_SHUTDOWN=false
AWS_HOST_IP=your_aws_host_ip_here
BROAD_SUBSCRIBE=true
MORNING_BROAD_AGG_START=09:15
MORNING_BROAD_AGG_END=09:35

# TimescaleDB & PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=zerodha_trading
DB_SSL_MODE=disable
GODEBUG=netdns=go

# Global Risk Controls & Position Limits
INITIAL_CAPITAL=5001
MAX_TRADES_PER_DAY=1
MAX_LOSS_STREAKS=1
MAX_HOLDING_TIME_MIN=360
MAX_CAPITAL_PER_TRADE=5000.0
MAX_DAILY_LOSS_AMOUNT=51.0
STRATEGY_WATCHLIST_SIZE=15
MANUAL_BIAS_CUTOFF=09:25
MANUAL_WATCHLIST_CUTOFF=09:25
AUTO_SQUARE_OFF_TIME=15:14
STOCK_SELECT_TIME=09:25
EVG_STOCK_SELECT_TIME=09:07

# Monitoring & Logging Metrics
LOG_LEVEL=info

# EMA Technical Indicator Configuration
EMA_FAST_PERIOD=10
EMA_SLOW_PERIOD=20
EMA_CANDLE_INTERVAL=5minute
EMA_ENABLED_FOR_TRADING=false

# Active Strategy Selection
ACTIVE_STRATEGIES=LOW_VOLUME,VANDE_BHARAT
ACTIVE_SELECTORS=SECURITIES_FO,SECTORAL,EQUITY_VOLUME_GAINERS
STRATEGY_SELECTOR_MAP=LOW_VOLUME:SECURITIES_FO,VANDE_BHARAT:SECTORAL
RISK_REWARD_TYPE=STANDARD
RISK_REWARD_RATIO=1.5

# ==========================================
# 2. LOW_VOLUME STRATEGY PARAMETERS
# ==========================================
LV_SL_BUFFER_PCT=5.0
LV_WATCHLIST_MAX_PCT_CHANGE=2.5
LV_TRADE_END_TIME=10:30
LV_USE_BROKER_SL=true
LV_MIN_CANDLES_TO_IGNORE=3

# ==========================================
# 3. VANDE_BHARAT STRATEGY PARAMETERS
# ==========================================
VB_SECTOR_MAX_BUY_PCT=2.5
VB_SECTOR_MAX_SELL_PCT=-3.0
VB_STOCK_MAX_BUY_PCT=2.5
VB_STOCK_MAX_SELL_PCT=-2.5
VB_MASTER_MAX_PCT=3.0
VB_CONFIRM_MIN_PCT=0.5
VB_CONFIRM_MAX_PCT=1.0
VB_MASTER_MAX_WICK_PCT=40.0
VB_STOCK_MAX_DAY_CHANGE_PCT=3.0
VB_TRADE_END_TIME=09:34
VB_SL_BUFFER_PCT=5.0
VB_USE_BROKER_SL=true
VB_MIN_CANDLES_TO_IGNORE=2

# ==========================================
# 4. TRIPLE SUPERTREND OPTIONS BOT PARAMETERS
# ==========================================
OPTIONS_LIVE_TRADING=false
OPTIONS_PAPER_BALANCE=1000000.0
INDEX_SYMBOL=NIFTY 50
OPTIONS_ACTIVE_INDICES=NIFTY 50,BANKNIFTY,SENSEX,FINNIFTY,MIDCPNIFTY
OPTIONS_LIVE_INDICES=
OPTIONS_BASE_LOT_SIZE=65
OPTIONS_AUTO_SQUARE_OFF_TIME=14:58
OPTIONS_LAST_NEW_TRADE_TIME=14:41
SUPER_TREND_CUTOFF_TIME=15:10
STRIKE_OFFSET_POINTS=300
OPTIONS_TARGET_ENTRY_PREMIUM=100.0
OPTIONS_EXPIRY_TYPE=MONTHLY
OPTIONS_NEXT_MONTH_DAYS=7

# SuperTrend Indicator Parameters
SUPERTREND_ST1_PERIOD=10
SUPERTREND_ST1_FACTOR=4.0
SUPERTREND_ST2_PERIOD=7
SUPERTREND_ST2_FACTOR=3.0
SUPERTREND_ST3_PERIOD=7
SUPERTREND_ST3_FACTOR=2.0

# Options Risk & Sizing Controls
OPTIONS_SL_PCT=50.0
OPTIONS_TRAIL_SL_ENABLED=true
OPTIONS_TRAIL_SL_PCT=20.0
MAX_QUANTITY_MULTIPLIER=3
EXPIRY_CUTOFF_TIME=14:30
MAX_BID_ASK_SPREAD_PCT=10.0
OPTIONS_TRADE_MODE=INTRADAY

# ==========================================
# 5. QUANT STOCK SCANNER PARAMETERS
# ==========================================
SCANNER_ENABLED=true
SCANNER_EXECUTION_TIME=09:14
SCANNER_MOMENTUM_DAYS=3
SCANNER_NEWS_ENABLED=true
