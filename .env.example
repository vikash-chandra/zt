# ==========================================
# 1. BROKER API & SYSTEM CONNECTIVITY
# ==========================================

# Zerodha Kite Connect API Credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_user_id_here
KITE_ACCESS_TOKEN=your_access_token_here
KITE_TOKEN_PREFIX=vj:zt-ut:
KITE_REDIRECT_URL=http://localhost:8080/

# Server & Network Infrastructure
AWS_HOST_IP=your_aws_host_ip_here
BROAD_SUBSCRIBE=true
MORNING_BROAD_AGG_START=09:15
MORNING_BROAD_AGG_END=09:35

# UI Bot Restart Allowed Windows (Locked during Market Hours)
BOT_RESTART_ALLOWED_BEFORE=09:15
BOT_RESTART_ALLOWED_AFTER=15:45

# Logging & Monitoring
LOG_LEVEL=info

# ==========================================
# 2. TIMESCALEDB & POSTGRESQL CONNECTION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=zerodha_trading
DB_SSL_MODE=disable
GODEBUG=netdns=go

# ==========================================
# NOTE: All Trading Strategies, Risk Controls, Stock Selection,
# Option Indices Parameters, and Quant Scanner settings are now
# managed persistently in the PostgreSQL database and configured
# directly via the UI Settings Modal (⚙️ Settings button in dashboard).
# ==========================================
