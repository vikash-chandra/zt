# ==========================================
# 1. BROKER API & SYSTEM CONNECTIVITY
# ==========================================

# Zerodha Kite Connect API Credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_user_id_here
KITE_ACCESS_TOKEN=your_access_token_here
KITE_TOKEN_PREFIX=vj:vridhi:
KITE_REDIRECT_URL=http://localhost:8080/

# Server & Network Infrastructure
AWS_HOST_IP=your_aws_host_ip_here
BROAD_SUBSCRIBE=true
MORNING_BROAD_AGG_START=09:15:00
MORNING_BROAD_AGG_END=09:45:00

# UI Bot Restart Allowed Windows (Locked during Market Hours)
BOT_RESTART_ALLOWED_BEFORE=09:15:00
BOT_RESTART_ALLOWED_AFTER=15:45:00

# Logging & Monitoring
LOG_LEVEL=info

# Execution & Slippage Controls
EQUITY_LIMIT_BUFFER_PCT=0.2
ENTRY_LIMIT_MODE=DIRECT_LIMIT
ENTRY_LIMIT_ANCHOR=CONFIRMATION_CANDLE
ENTRY_LIMIT_OFFSET_TICKS=-2
ENTRY_LIMIT_MAX_CHASE_TICKS=5
ENTRY_LIMIT_TIMEOUT_SEC=60
VB_CANDLE_TIMEFRAME=5m
VBT_CANDLE_TIMEFRAME=5m

# Per-Strategy Limit Order Timeout in Seconds (Cancel pending order if unfilled)
ES5_LIMIT_TIMEOUT_SEC=60
VB_LIMIT_TIMEOUT_SEC=45
VBT_LIMIT_TIMEOUT_SEC=45
FB_LIMIT_TIMEOUT_SEC=45
LV_LIMIT_TIMEOUT_SEC=30

# Multi-Validation: Mandatory Institutional Footprint (IFP) Check per Strategy
LV_REQUIRE_IFP_VALIDATION=false
VB_REQUIRE_IFP_VALIDATION=false
FB_REQUIRE_IFP_VALIDATION=false
VBT_REQUIRE_IFP_VALIDATION=false
ES5_REQUIRE_IFP_VALIDATION=false
ES5_CONFIRM_MASTER_MIN_SIZE_PCT=0.4
ES5_BREAKOUT_BUFFER_PCT=0.05

# Per-Strategy Minimum Breakout Buffer in Ticks (1 tick = ₹0.05 on NSE)
ES5_BREAKOUT_BUFFER_TICKS=1
ES5_SL_USE_MASTER_CANDLE=false
VB_BREAKOUT_BUFFER_TICKS=1
VBT_BREAKOUT_BUFFER_TICKS=1
FB_BREAKOUT_BUFFER_TICKS=1
LV_BREAKOUT_BUFFER_TICKS=1

# Market Trend Alignment: NIFTY 50 EMA Filter
MARKET_TREND_ALIGNMENT_ENABLED=false
MARKET_TREND_NIFTY_EMA_PERIOD=20
VB_ENFORCE_MARKET_TREND=false
LV_ENFORCE_MARKET_TREND=false
ES5_ENFORCE_MARKET_TREND=false
VBT_ENFORCE_MARKET_TREND=false
FB_ENFORCE_MARKET_TREND=false

# ==========================================
# 2. TIMESCALEDB & POSTGRESQL CONNECTION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=zerodha_trading
DB_SSL_MODE=disable
GODEBUG=netdns=go

# ==========================================
# 3. ZERODHA BROKERAGE & TAX CONFIGURATION
# ==========================================
BROKERAGE_EQUITY_INTRADAY_PCT=0.03
BROKERAGE_EQUITY_INTRADAY_MAX_PER_ORDER=20.0
STT_EQUITY_INTRADAY_SELL_PCT=0.025
EXCHANGE_TXN_EQUITY_NSE_PCT=0.00307
STAMP_DUTY_EQUITY_BUY_PCT=0.003

BROKERAGE_OPTIONS_FLAT_PER_ORDER=20.0
STT_OPTIONS_SELL_PCT=0.10
EXCHANGE_TXN_OPTIONS_NSE_PCT=0.03553
STAMP_DUTY_OPTIONS_BUY_PCT=0.003

SEBI_TURNOVER_CHARGES_PER_CRORE=10.0
GST_RATE_PCT=18.0
CALCULATE_CHARGES_ENABLED=true

OPTIONS_SL_BUFFER_TICKS=2
OPTIONS_TRAIL_SL_BUFFER_TICKS=30
OPTIONS_MASTER_CANDLE_BUFFER_TICKS=0

# ==========================================
# 4. ENTERPRISE AUTHENTICATION & JWT SECURITY
# ==========================================
JWT_SECRET=vridhi_super_secret_jwt_signing_key_2026_change_in_production
JWT_EXPIRY_HOURS=12

# ==========================================
# NOTE: All Trading Strategies, Risk Controls, Stock Selection,
# Option Indices Parameters, and Quant Scanner settings are now
# managed persistently in the PostgreSQL database and configured
# directly via the UI Settings Modal (⚙️ Settings button in dashboard).
# ==========================================
